{
    "name": "@Neurogine/core-network",
    "version": "1.0.0",
    "description": "core network module",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "postinstall": "npm run build",
        "prepare": "npm run build",
        "build": "rm -rf dist && tsc --noEmitOnError false || exit 0",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "watch": "tsc --watch",
        "prepublishOnly": "yarn build",
        "typescript": "tsc --noEmit",
        "lint": "ESLINT_USE_FLAT_CONFIG=true eslint . --no-cache",
        "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint . --fix --no-cache",
        "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --coverage",
        "test:update": "jest -u"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.0.0",
        "axios": "^1.7.0",
        "globals": "^17.12.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.70.0"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-native": "*"
    },
    "devDependencies": {
        "@babel/core": "^8.0.5",
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@react-native/babel-preset": "^0.87.1",
        "@react-native/jest-preset": "^0.87.1",
        "@react-native/typescript-config": "0.87.1",
        "@testing-library/react-native": "^14.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.5.1",
        "@types/react": "19.3.0",
        "@types/react-native": "^0.72.0",
        "eslint": "^10.10.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-native": "^5.0.0",
        "globals": "^17.12.0",
        "jest": "29.7.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "react": "^19.3.0",
        "react-native": "^0.87.1",
        "test-renderer": "^1.2.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.70.0"
    }
}
